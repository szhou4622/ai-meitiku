 class DeviceApiError(Exception):
-    def __init__(self, message, status=400):
+    def __init__(self, message, status=400, code=""):
         super().__init__(message)
         self.status = int(status)
+        self.code = str(code or "")
 
 
+def _scoped_device_error(message, status, app_name, code):
+    """Attach machine-readable codes only for AI媒体库; other apps stay byte-compatible."""
+    return DeviceApiError(
+        message,
+        status,
+        code if str(app_name or "").strip() == "ai-media-library" else "",
+    )
+
+
+class AiMediaTimeConflictError(ValueError):
+    """A rejected time-card attempt; never consumes the submitted code."""
+
+    def __init__(self, error_code, action, message):
+        super().__init__(message)
+        self.error_code = error_code
+        self.action = action
+        self.status = 409
+
+
+def _aiml_auth_matches_primary(authenticated_row, primary, machine_code, supplied_credential=""):
+    if not authenticated_row or not primary:
+        return False
+    return (
+        str(authenticated_row.get("app_name") or "") == "ai-media-library"
+        and str(authenticated_row.get("code_id") or "") == str(primary["code_id"] or "")
+        and str(authenticated_row.get("bound_machine_code") or "").strip().upper() == machine_code
+        and str(primary["bound_machine_code"] or "").strip().upper() == machine_code
+        and str(authenticated_row.get("binding_status") or "") == "active"
+        and str(authenticated_row.get("binding_role") or "") == "primary"
+        and int(authenticated_row.get("credential_version") or 0) == int(primary["credential_version"] or 0)
+        and bool(authenticated_row.get("device_credential_hash"))
+        and hmac.compare_digest(
+            str(authenticated_row.get("device_credential_hash") or ""),
+            str(primary["device_credential_hash"] or ""),
+        )
+        and (
+            not supplied_credential
+            or hmac.compare_digest(
+                _credential_hash(supplied_credential),
+                str(primary["device_credential_hash"] or ""),
+            )
+        )
+    )
+
